# ============================================================
# Directorio privado / de pruebas - no indexar, no listar
# ============================================================
Options -Indexes -MultiViews

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

# Bloquear archivos sensibles dentro de esta carpeta
<FilesMatch "\.(env|ini|log|sql|bak|old|swp|conf|yml|yaml|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule \!mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
